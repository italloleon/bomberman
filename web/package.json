{
  "name": "bomber-web",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/client-wasm --target web --out-dir ../../web/src/wasm --out-name client --no-pack",
